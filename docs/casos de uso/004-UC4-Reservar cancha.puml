' ============================================
' UC4 - Reservar cancha
' ============================================
@startuml UC4_ReservarCancha
left to right direction
title UC4 - Reservar cancha

actor Usuario

rectangle "Sistema de reservas de canchas" {
  usecase "Reservar cancha" as UC4
  usecase "Iniciar sesión" as UC2
  usecase "Pagar reserva (simulado)" as UC5
  usecase "Verificar disponibilidad" as V1
  usecase "Calificar cancha" as UC6
}

Usuario --> UC4
UC4 .> UC2 : <<include>>
UC4 .> V1 : <<include>>
UC4 .> UC5 : <<include>>
UC6 .> UC4 : <<extend>>

@enduml